# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave empty locally: the app uses a SQLite file in ./data.
# REQUIRED on Vercel: the Supabase Postgres connection string (Project Settings > Database >
# Connection string > "Transaction pooler", port 6543). Server-side only - never expose it.
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Sessions (server-side secret, 32+ random characters). Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Google sign-in (optional). OAuth "Web application" client ID from Google Cloud Console.
# Add your site URL (e.g. https://your-app.vercel.app and http://localhost:3000) under
# "Authorized JavaScript origins". The client ID is public; there is no client secret to store.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""

# ---------------------------------------------------------------------------
# Super Admin portal (/superadmin). The account is created/updated at startup.
# Set SUPERADMIN_PASSWORD (8+ chars) for password sign-in; with only SUPERADMIN_EMAIL set,
# that Google account can sign in to the portal with Google.
# ---------------------------------------------------------------------------
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# WhatsApp (Meta WhatsApp Business Platform, coexistence). See docs/WHATSAPP.md.
# META_APP_ID / META_CONFIG_ID are public identifiers; the rest are server-side secrets.
# ---------------------------------------------------------------------------
META_APP_ID=""
META_CONFIG_ID=""
META_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
# Recommended: 32+ random characters (openssl rand -hex 32). Encrypts each store's WhatsApp token at rest.
WHATSAPP_ENCRYPTION_KEY=""
# Optional (default v23.0)
META_GRAPH_VERSION=""
